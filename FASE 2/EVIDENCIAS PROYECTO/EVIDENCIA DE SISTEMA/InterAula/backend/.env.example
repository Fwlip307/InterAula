# Configuración del Servidor Backend InterAula
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Conexión con Supabase en la nube
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica

# Clave de Servicio (Privada - Solo para operaciones administrativas en el servidor)
# NUNCA compartir ni exponer en el frontend
SUPABASE_SERVICE_ROLE_KEY=

# Clave de Google Gemini (Opcional en backend - Privada)
GEMINI_API_KEY=

# Apply migrations 016 and 017 before using the corrected flows.
# Interests and the personalized feed also require migration 018 (no extra private key).
# Accreditation attempts require SUPABASE_SERVICE_ROLE_KEY only on this server.
# Local persistence is enabled by the automated test setup, never by the application.
