# Configuración del Servidor Backend InterAula
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Conexión con Supabase en la nube
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica

# Clave de Servicio (Privada - Solo para operaciones administrativas en el servidor)
# NUNCA compartir ni exponer en el frontend
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-privada

# Clave de Google Gemini (Opcional en backend - Privada)
GEMINI_API_KEY=tu-clave-privada-gemini
