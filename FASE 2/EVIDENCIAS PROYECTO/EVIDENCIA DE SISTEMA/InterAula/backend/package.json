{
  "name": "interaula-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API REST propio para InterAula con Express, TypeScript y Supabase",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
