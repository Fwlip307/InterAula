# Variables de entorno públicas del cliente (Vite)
# ADVERTENCIA: NUNCA coloques claves secretas (como GEMINI_API_KEY o service_role) en este archivo.
# Las claves de IA se configuran en el servidor mediante: supabase secrets set GEMINI_API_KEY=tu_clave

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
