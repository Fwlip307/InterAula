# =====================================================================
# InterAula - Variables de entorno (Frontend + Docker Compose)
# ADVERTENCIA: NUNCA subas archivos .env reales con claves secretas a Git.
# =====================================================================

# En desarrollo local (Vite sin Docker) usa http://localhost:3001/api
# En Docker (Nginx proxy inverso) el compose usa /api automáticamente si se omite
VITE_API_URL=/api

# Conexión a Supabase Cloud (instancia de InterAula)
VITE_SUPABASE_URL=https://llbwkvxitgvqclssqujp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ziM8RqCEkz0Sh3fERo4GrA_MPMgQIsA

# Variables usadas por el Backend en Docker (si no existen, toman las VITE_* de arriba)
SUPABASE_URL=https://llbwkvxitgvqclssqujp.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ziM8RqCEkz0Sh3fERo4GrA_MPMgQIsA
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Puertos opcionales para Docker (por defecto 80 y 3001)
# FRONTEND_PORT=80
# BACKEND_PORT=3001

# Modelo de IA configurable; solo lo utiliza el servidor
GEMINI_MODEL=gemini-3.5-flash-lite

# Class notifications: Resend server key only; never use VITE_ for these values.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
APP_PUBLIC_URL=
